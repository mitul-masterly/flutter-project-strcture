default_platform(:ios)

platform :ios do
  desc "Build and Upload to TestFlight"
  lane :upload_staging_to_testflight do

    app_identifier = "com.masterly.flutterbasecodestg"

    app_store_connect_api_key(
        key_id: ENV["APP_STORE_API_KEY_ID"],
        issuer_id: ENV["APP_STORE_ISSUER_ID"],
        key_content: ENV["APP_STORE_API_KEY_CONTENT"]
    )

    # ✅ Set Build Number
    latest_build = latest_testflight_build_number(
      app_identifier: app_identifier
    )

    # Fallback to 0 if nil or empty, then increment
    new_build_number = (latest_build || 0) + 1

    puts "Setting build number to #{new_build_number}"

    increment_build_number(
      build_number: new_build_number.to_s
    )

    # ✅ Build the app
    build_app(
      scheme: "staging",
      workspace: "Runner.xcworkspace",
      export_method: "app-store",
      output_directory: "../build/ios/ipa",
      output_name: "flutterBaseStaging.ipa",
      export_options: {
        provisioningProfiles: {
          "com.masterly.flutterbasecodestg" => "masterly_flutterbasecode_ios_appstore"
        }
      }
    )

    upload_to_testflight(
      ipa: "../build/ios/ipa/flutterBaseStaging.ipa",
      api_key: {
               key_id: ENV["APP_STORE_API_KEY_ID"],
               issuer_id: ENV["APP_STORE_ISSUER_ID"],
               key: ENV["APP_STORE_API_KEY_CONTENT"],
               in_house: false
            },
      skip_waiting_for_build_processing: true,
      skip_submission: true
    )
  end
end
